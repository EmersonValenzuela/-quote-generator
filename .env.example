# Plantilla sin credenciales. Copiar a .env solo para desarrollo local.
# Consulta docs/operations.md: varias variables son reservadas y no tienen efecto actual.

# APP_ENV lo usan las guardas de seed/recuperación. APP_TIMEZONE y APP_LOG_LEVEL
# se validan, pero aún no cambian el comportamiento del sistema.
APP_ENV=development
APP_TIMEZONE=America/Lima
APP_LOG_LEVEL=info

# PostgreSQL: runtime usa DATABASE_URL; Prisma CLI/seed prefieren DIRECT_URL.
# Sustituye por URLs de una base aislada de desarrollo. No reutilices production.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cotizador_dev?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/cotizador_dev?schema=public

# Better Auth: BETTER_AUTH_SECRET requiere al menos 32 caracteres.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# PDF_ENGINE está reservado; la descarga actual selecciona react-pdf directamente.
# CHROMIUM_EXECUTABLE_PATH solo se usa por el renderer de comparación local.
PDF_ENGINE=react-pdf
CHROMIUM_EXECUTABLE_PATH=

# Reservada: no hay integración de Vercel Blob ni almacenamiento de PDFs.
BLOB_READ_WRITE_TOKEN=

# Solo CLI pnpm db:seed. Nunca apuntar modo demo a una base real/production.
SEED_MODE=bootstrap
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ALLOW_PRODUCTION=false

# Reservadas: Sentry no está instalado/configurado y estas variables no se leen.
SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_APP_ENV=development

# No se integra IA, correo transaccional, Browserless ni servicios de pago.
